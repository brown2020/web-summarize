# Web Summarize - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ===========================================
# AI Provider API Keys
# At least one is required for the app to work
# ===========================================

# OpenAI - GPT-6.1 Sol (Required - default fallback)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - Claude Opus 5.5 (Optional)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google - Gemini 4 Argon (Optional)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# xAI - Grok 4.7 (Optional)
# Get your key at: https://console.x.ai/
XAI_API_KEY=

# ===========================================
# Firebase Auth (email/password and email link)
# Public web app config from the Firebase console. No private key.
# Sign-in stays disabled until these are set. /api/summarize then returns 401.
# ===========================================
NEXT_PUBLIC_FIREBASE_APIKEY=
NEXT_PUBLIC_FIREBASE_AUTHDOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECTID=
NEXT_PUBLIC_FIREBASE_STORAGEBUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDERID=
NEXT_PUBLIC_FIREBASE_APPID=

# ===========================================
# Fixtures (CI / app-eval — avoid paid LLM burn)
# ===========================================
# When true, /api/proxy and POST /api/summarize return labeled fixtures.
# Fixtures cannot prove live provider quality, latency, or metering.
# SUMMARIZE_USE_FIXTURES=true
